rules_version = '2';

// This app now uses Firebase Authentication (Google sign-in) for both the
// admin console and the "personal phone" kiosk path. The rule below requires
// *some* signed-in Google account to read/write — which email addresses are
// actually allowed to see the admin screens or act as a specific mikveh's
// staff is enforced inside the app itself (see the "הרשאות" tab), against
// the admin-emails / kiosk-emails lists.
//
// This is a reasonable first line of defense (random internet visitors with
// no Google account are blocked entirely), but it is NOT equivalent to
// server-side allowlist enforcement — anyone with a Google account could in
// principle still write directly to Firestore, bypassing the app's UI. For
// stronger protection later, look into Firebase custom claims + rules that
// check request.auth.token against the admin-emails/kiosk-emails documents.

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_data/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}

