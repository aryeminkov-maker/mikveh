rules_version = '2';

// ⚠️ IMPORTANT — read before you go live.
// This starter opens the "app_data" collection to anyone with your Firebase
// config (which is not secret, and ends up visible in your deployed site's
// JS bundle). That's fine for local testing, but this app stores real cash
// totals, phone numbers and staff activity — do NOT leave it this open once
// real people are using it.
//
// Minimum recommended next step: turn on Firebase Authentication (e.g. email
// links or phone auth for staff), then replace the rule below with:
//
//   match /app_data/{docId} {
//     allow read, write: if request.auth != null;
//   }
//
// For finer control you could also split kiosk-writable keys from
// admin-only keys (e.g. audit-log should probably not be deletable by staff).

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_data/{docId} {
      allow read, write: if true; // TODO: replace before production use
    }
  }
}
